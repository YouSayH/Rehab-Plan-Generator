# File: frontend/Dockerfile
#
# Summary:
# フロントエンド（React/Vite）用のDockerイメージ構築ファイル。
# `node:24-slim` をベースイメージとして採用し、パッケージのインストールを行った上で、コンテナ外からアクセス可能な状態（`--host` オプション）でViteの開発サーバーを起動するための設定が記述されています。
#
# Tags: Dockerfile, Frontend, Node.js, React, Vite

# ----------------------------------------------------------------
# 1. Base Image
# ----------------------------------------------------------------
# Node.js 20 (LTS) の軽量版を使用
FROM node:24-slim

# 作業ディレクトリ
WORKDIR /app

# ----------------------------------------------------------------
# 2. Dependencies
# ----------------------------------------------------------------
# package.json (とあればlockファイル) を先にコピー
COPY package.json package-lock.json* ./

# 依存関係のインストール
# --legacy-peer-deps: 互換性エラーを無視してインストール（開発初期は安定重視）
RUN npm install --legacy-peer-deps

# ----------------------------------------------------------------
# 3. Runtime
# ----------------------------------------------------------------
# ソースコードをコピー
COPY . .

# 開発サーバー起動
# --host: コンテナ外からアクセス可能にする必須フラグ
CMD ["npm", "run", "dev", "--", "--host"]